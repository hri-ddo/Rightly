POSTGRES_DB=rightly
POSTGRES_USER=rightly
POSTGRES_PASSWORD=rightly
DATABASE_URL=jdbc:postgresql://localhost:5432/rightly

REDIS_URL=redis://localhost:6379

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rightly-evidence

# Use filesystem when MinIO/Docker is unavailable (Homebrew-only dev)
RIGHTLY_STORAGE_DRIVER=filesystem
RIGHTLY_UPLOAD_DIR=./uploads

MAIL_HOST=localhost
MAIL_PORT=1025

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_SESSION_TTL_HOURS=168

CORS_ALLOWED_ORIGINS=http://localhost:5173

LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBED_MODEL=text-embedding-3-small

SERVER_PORT=8081